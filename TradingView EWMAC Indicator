//@version=6
indicator("Exponentially Weighted Moving Average Crossover", shorttitle="EWMAC", overlay=false, max_labels_count=500)

// ────────────────────────────── Pair Dropdown ──────────────────────────────
pair_str = input.string("16/64", "EWMAC Pair", options=["2/8", "4/16", "8/32", "16/64", "32/128", "64/256"])

// Parse the selected pair and its scalar (from Python config)
[fast, slow, scalar] = switch pair_str
    "2/8"   => [2,   8,   10.6]
    "4/16"  => [4,   16,  7.5]
    "8/32"  => [8,   32,  5.3]
    "16/64" => [16,  64,  3.75]
    "32/128"=> [32,  128, 2.65]
    =>       [64,  256, 1.87]

// ────────────────────────────── Other Inputs ──────────────────────────────
stdev_window = input.int(1440, "StdDev Window", minval=2)
capmin = input.float(-20, "Cap Min")
capmax = input.float(20, "Cap Max")
buy_thresh = input.float(0, "Buy Threshold")
sell_thresh = input.float(0, "Sell Threshold")

// ────────────────────────────── Calculations ──────────────────────────────
fast_ewma = ta.ema(close, fast)
slow_ewma = ta.ema(close, slow)

raw_ewmac = fast_ewma - slow_ewma

// Rolling standard deviation of price changes
stdev = 0.0
if bar_index >= stdev_window - 1
    sum = 0.0
    sumSq = 0.0
    for i = 0 to stdev_window - 1
        diff = close[i] - close[i + 1]
        sum := sum + diff
        sumSq := sumSq + diff * diff
    mean = sum / stdev_window
    variance = (sumSq / stdev_window) - (mean * mean)
    stdev := math.sqrt(math.max(variance, 0))

if stdev < syminfo.mintick * 0.1
    stdev := close * 0.002

vol_adj = stdev > 0 ? raw_ewmac / stdev : 0.0
forecast = vol_adj * scalar
cap_forecast = math.max(capmin, math.min(capmax, forecast))

is_bull_cross = fast_ewma > slow_ewma

// ────────────────────────────── Carver Signal Translation (Table 16) ──────────────────────────────
// Maps capped forecast to opinion strength
f_signal_label(float f) =>
    if f >= 17.5
        "Very strong buy"
    else if f >= 12.5
        "Strong buy"
    else if f >= 7.5
        "Buy"
    else if f >= 2.5
        "Weak buy"
    else if f > -2.5
        "Neutral"
    else if f > -7.5
        "Weak sell"
    else if f > -12.5
        "Sell"
    else if f > -17.5
        "Strong sell"
    else
        "Very strong sell"

signal_label = f_signal_label(cap_forecast)

// ────────────────────────────── Color Definitions ──────────────────────────────
color_fast_bull   = #2ecc71
color_fast_bear   = #e74c3c
color_slow        = color.new(#0080ff, 30)
color_forecast    = color.new(#3498db, 0)
color_buy_zone    = color.new(#27ae60, 85)
color_sell_zone   = color.new(#c0392b, 85)
color_buy_signal  = #2ecc71
color_sell_signal = #e74c3c
color_cap_line    = color.new(#7f8c8d, 50)
color_table_bg    = color.new(#1c2526, 70)
color_table_border= color.new(#3498db, 60)

color_fast_dynamic = is_bull_cross ? color_fast_bull : color_fast_bear

// Color for the signal label itself
signal_color = cap_forecast > 2.5 ? color_buy_signal : 
               cap_forecast < -2.5 ? color_sell_signal : 
               color.new(#f1c40f, 0)   // Neutral = yellow

// ────────────────────────────── Price Chart ──────────────────────────────
plot(fast_ewma, title="Fast EWMA", color=color.new(color_fast_dynamic, 25), linewidth=1, force_overlay=true)
plot(slow_ewma, title="Slow EWMA", color=color_slow, linewidth=1, force_overlay=true)

bgcolor(ta.crossover(fast_ewma, slow_ewma)  ? color.new(color_buy_zone,  96) : na, title="EMA Bull Cross")
bgcolor(ta.crossunder(fast_ewma, slow_ewma) ? color.new(color_sell_zone, 96) : na, title="EMA Bear Cross")

// ────────────────────────────── Separate Pane ──────────────────────────────
plot(capmax, title="Scale Anchor Max", color=color.new(color.white, 100), display=display.none)
plot(capmin, title="Scale Anchor Min", color=color.new(color.white, 100), display=display.none)

p_forecast = plot(cap_forecast, title="Capped Forecast", color=color_forecast, linewidth=2)
p_zero = plot(0, title="Zero", color=color.new(color.white, 100), display=display.none)

fill(p_forecast, p_zero,
     color = cap_forecast > buy_thresh  ? color.new(#27ae60, 75) :
             cap_forecast < sell_thresh ? color.new(#c0392b, 75) :
             color.new(#3498db, 90),
     title="Forecast Zone Fill")

hline(buy_thresh,  title="Buy Threshold",  color=color.new(#27ae60, 40), linestyle=hline.style_dashed)
hline(sell_thresh, title="Sell Threshold", color=color.new(#c0392b, 40), linestyle=hline.style_dashed)
hline(capmax,      title="Cap Max",        color=color_cap_line,          linestyle=hline.style_dotted)
hline(capmin,      title="Cap Min",        color=color_cap_line,          linestyle=hline.style_dotted)
hline(0,           title="Zero Line",      color=color.new(#7f8c8d, 60),  linestyle=hline.style_solid)

// ────────────────────────────── Signals ──────────────────────────────
buy_signal  = ta.crossover(cap_forecast,  buy_thresh)
sell_signal = ta.crossunder(cap_forecast, sell_thresh)

bgcolor(buy_signal  ? color.new(color_buy_zone,  92) : na)
bgcolor(sell_signal ? color.new(color_sell_zone, 92) : na)

// ────────────────────────────── Info Panel (updated) ──────────────────────────────
var table hud = table.new(position.top_right, 1, 5, bgcolor=color_table_bg, border_width=1, border_color=color_table_border, frame_width=1, frame_color=color_table_border)

if barstate.islast
    table.cell(hud, 0, 0, "PAIR: " + pair_str, text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 1, "SCALAR: " + str.tostring(scalar, "#.2f"), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 2, "CAPPED FORECAST", text_color=color_forecast, text_size=size.small)
    table.cell(hud, 0, 3, str.tostring(math.round(cap_forecast, 2)), text_color=cap_forecast >= 0 ? color_buy_signal : color_sell_signal, text_size=size.large)
    table.cell(hud, 0, 4, signal_label, text_color=signal_color, text_size=size.normal)
